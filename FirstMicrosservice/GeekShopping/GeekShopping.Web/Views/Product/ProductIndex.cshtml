@model IEnumerable<GeekShopping.Web.Models.ProductModel>
<br/>
<br/>
<div class="container p-4 border">
    <div class="row pb-2">
        <div class="col-md-12">
            <h2 class="text-primary">Products</h2>

        </div>
        <div class="col text-end pt-1">
            <a asp-action="ProductCreate" class="btn btn-outline-primary">
                <i class="fa fa-plus"></i> Create new product
            </a>
        </div>
    </div>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Price</th>
                <th scope="col">Description</th>
                <th scope="col">Category</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.Description</td>
                    <td>@product.CategoryName</td>
                    <td>
                        <a asp-action="ProductUpdate" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-edit"></i> Edit
                        </a>
                        <a asp-action="ProductDelete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">
                            <i class="fa fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
</div>